# Copy to .env.local. Only VITE_ZITADEL_CLIENT_ID has no default.
VITE_ZITADEL_CLIENT_ID=
# Local stack (OrbStack compose, see core-backend):
# VITE_ZITADEL_ISSUER=http://zitadel.monorepo.orb.local:8080
# VITE_ZITADEL_PROJECT_ID=<project id from compose bootstrap>
# VITE_API_URL=http://localhost:8090
# `pnpm dev:local` runs against the local stack: it loads `.env.stack.local` (gitignored) with the four values above, pointed at your
# local Zitadel app and core-api. `pnpm api:gen:local` fetches the types from http://localhost:8090. Plain `pnpm api:gen` reads VITE_API_URL
# (shell or .env.local) and fetches <it>/openapi.json.
# Production defaults: https://auth.drills.pro, https://api.drills.pro
