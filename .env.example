# Copy to .env.local. Only VITE_ZITADEL_CLIENT_ID has no default.
VITE_ZITADEL_CLIENT_ID=
# Local stack (OrbStack compose, see core-backend):
# VITE_ZITADEL_ISSUER=http://zitadel.monorepo.orb.local:8080
# VITE_ZITADEL_PROJECT_ID=<project id from compose bootstrap>
# VITE_API_URL=http://localhost:8090
# Production defaults: https://auth.drills.pro, https://api.drills.pro

# Copy to .env (git-ignored).
#
# Organizations, invitations, projects, the catalog, search and the dashboard
# come from core-api. Everything else (datasets, training, models,
# deployments, account, billing) is answered by the in-app mock
# (src/api/mock/) until core-api serves it: docs/api-contract.md.

# How much the mock answers:
#   unset or true  what core-api doesn't serve yet (the default)
#   all            everything, so the app runs with no backend at all
#   false          nothing; every call goes to core-api
VITE_API_MOCK=true
# How long a mocked answer takes, in ms, so loading states are visible.
VITE_API_MOCK_DELAY_MS=200

# core-api base URL. The compose stack publishes it on :8090.
VITE_API_URL=http://localhost:8090

# Mock auth: there is no login yet, so requests carry core-api's dev headers.
# This only works against a backend running AUTH_MODE=dev (the compose default).
# Your home organization, a tenant UUID from core-api's `tenants` table. You
# own it; the app shows "Could not load your workspace" without it.
#   docker compose exec postgres psql -U postgres -d core -c 'select id, name from tenants'
VITE_DEV_TENANT_ID=

# Optional. Who you are: the actor on anything you create, and the member
# other people invite. Defaults to dev-user.
VITE_DEV_USER_ID=
# Optional. Your address; invitations sent to it show on the organizations
# page for you to accept.
VITE_DEV_USER_EMAIL=
# Optional. The name in the dashboard greeting; defaults to Alex.
VITE_DEV_USER_NAME=
