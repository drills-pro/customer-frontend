{
  "name": "@drillspro/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "tokens": "node scripts/gen-tokens.mjs",
    "typegen": "chakra typegen src/theme/index.ts",
    "lint": "eslint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm format:check && pnpm lint:project && pnpm lint:i18n && pnpm typecheck && pnpm build",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:project": "sh scripts/check-project.sh",
    "format": "prettier --write . && eslint --fix",
    "format:check": "prettier --check .",
    "generate-routes": "tsr generate",
    "preview": "vite preview",
    "test": "playwright test",
    "contract:export": "UPDATE_CONTRACT=1 playwright test tests/contract-fixtures.spec.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@chakra-ui/charts": "3.37.0",
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "1.59.0",
    "next-themes": "0.4.6",
    "oidc-client-ts": "^3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.21",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chakra-ui/cli": "3.37.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.20.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "packageManager": "pnpm@12.14.0"
}
