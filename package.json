{
  "name": "@drillspro/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "tokens": "node scripts/gen-tokens.mjs",
    "typegen": "chakra typegen src/theme/index.ts",
    "lint": "eslint && sh scripts/check-focus-styles.sh",
    "lint:fix": "oxlint --fix",
    "check": "prettier --check .",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:project": "sh scripts/check-project.sh",
    "format": "prettier --write . && eslint --fix",
    "format:check": "prettier --check .",
    "generate-routes": "tsr generate",
    "preview": "vite preview",
    "test": "playwright test",
    "lint:focus": "sh scripts/check-focus-styles.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@chakra-ui/charts": "3.37.0",
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.4",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "1.59.0",
    "next-themes": "0.4.6",
    "oidc-client-ts": "^3.5.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.21",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chakra-ui/cli": "3.37.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.20.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "packageManager": "pnpm@12.14.0"
}
