{
  "name": "@drillspro/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings && pnpm lint:project && pnpm lint:i18n",
    "lint:fix": "oxlint --fix",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:project": "sh scripts/check-project.sh",
    "typecheck": "pnpm typegen && tsc -p .",
    "typegen": "chakra typegen src/theme/index.ts",
    "tokens": "node scripts/gen-tokens.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@chakra-ui/charts": "3.37.0",
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "11.14.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-thai": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "i18next": "^26.4.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "1.59.0",
    "next-themes": "0.4.6",
    "oidc-client-ts": "^3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.21",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@chakra-ui/cli": "3.37.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "packageManager": "pnpm@12.14.0"
}
